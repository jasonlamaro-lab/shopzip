{% comment %}
  Page template
{% endcomment %}

<div class="page-template" style="padding: 40px 0;">
  <div style="max-width: 800px; margin: 0 auto;">
    <h1 style="font-size: 36px; margin-bottom: 30px;">{{ page.title }}</h1>
    
    <div style="line-height: 1.8; font-size: 16px;">
      {{ page.content }}
    </div>
  </div>
</div>
