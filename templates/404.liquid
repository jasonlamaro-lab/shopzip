{% comment %}
  404 Error page
{% endcomment %}

<div class="error-page" style="text-align: center; padding: 100px 20px;">
  <h1 style="font-size: 72px; color: #667eea; margin-bottom: 20px;">404</h1>
  <h2 style="font-size: 32px; margin-bottom: 20px;">Page Not Found</h2>
  <p style="font-size: 18px; color: #666; margin-bottom: 40px;">
    Sorry, the page you're looking for doesn't exist.
  </p>
  <a 
    href="/" 
    style="display: inline-block; background: #667eea; color: white; padding: 15px 40px; text-decoration: none; border-radius: 5px; font-weight: bold;"
  >
    Return to Home
  </a>
</div>
