{% comment %}
  Product template
{% endcomment %}

<div class="product-page" style="padding: 40px 0;">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto;">
    
    <div class="product-images">
      {% if product.featured_image %}
        <img 
          src="{{ product.featured_image | image_url: width: 800 }}" 
          alt="{{ product.featured_image.alt | escape }}"
          style="width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"
        >
      {% endif %}

      {% if product.images.size > 1 %}
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 20px;">
          {% for image in product.images limit: 4 %}
            <img 
              src="{{ image | image_url: width: 200 }}" 
              alt="{{ image.alt | escape }}"
              style="width: 100%; border-radius: 4px; cursor: pointer; border: 2px solid transparent;"
            >
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info">
      <h1 style="font-size: 32px; margin-bottom: 15px;">{{ product.title }}</h1>
      
      <div style="font-size: 28px; font-weight: bold; color: #667eea; margin-bottom: 20px;">
        {{ product.price | money }}
        {% if product.compare_at_price > product.price %}
          <span style="font-size: 18px; color: #999; text-decoration: line-through; margin-left: 10px;">
            {{ product.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      {% if product.description != blank %}
        <div style="line-height: 1.8; margin-bottom: 30px;">
          {{ product.description }}
        </div>
      {% endif %}

      {% form 'product', product %}
        <select name="id" style="width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid #ddd; border-radius: 4px;">
          {% for variant in product.variants %}
            <option 
              value="{{ variant.id }}" 
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }} - {{ variant.price | money }}
              {% unless variant.available %} (Sold Out){% endunless %}
            </option>
          {% endfor %}
        </select>

        <button 
          type="submit" 
          name="add"
          style="width: 100%; background: #667eea; color: white; padding: 15px; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;"
          {% unless product.available %}disabled{% endunless %}
        >
          {% if product.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</div>
