{% comment %}
  The home page template
{% endcomment %}

<div class="homepage">
  <section class="hero" style="text-align: center; padding: 80px 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 8px; margin-bottom: 40px;">
    <h1 style="font-size: 48px; margin-bottom: 20px;">Welcome to {{ shop.name }}</h1>
    <p style="font-size: 20px; margin-bottom: 30px;">Discover amazing products for your lifestyle</p>
    <a href="/collections/all" style="display: inline-block; background: white; color: #667eea; padding: 15px 40px; text-decoration: none; border-radius: 5px; font-weight: bold;">Shop Now</a>
  </section>

  {% if collections.frontpage.products.size > 0 %}
    <section class="featured-products" style="margin-bottom: 60px;">
      <h2 style="text-align: center; margin-bottom: 40px; font-size: 32px;">Featured Products</h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 30px;">
        {% for product in collections.frontpage.products limit: 8 %}
          <div style="border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; transition: transform 0.3s;">
            <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
              {% if product.featured_image %}
                <img 
                  src="{{ product.featured_image | image_url: width: 400 }}" 
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  style="width: 100%; height: 250px; object-fit: cover;"
                >
              {% else %}
                <div style="width: 100%; height: 250px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                  No Image
                </div>
              {% endif %}
              
              <div style="padding: 20px;">
                <h3 style="font-size: 18px; margin-bottom: 10px;">{{ product.title }}</h3>
                <p style="font-weight: bold; color: #667eea;">{{ product.price | money }}</p>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="about-section" style="text-align: center; padding: 60px 20px; background: #f8f9fa; border-radius: 8px;">
    <h2 style="font-size: 32px; margin-bottom: 20px;">About Our Store</h2>
    <p style="font-size: 18px; max-width: 600px; margin: 0 auto; line-height: 1.8;">
      We're dedicated to bringing you the best products with exceptional quality and service. 
      Shop with confidence and enjoy our curated collection.
    </p>
  </section>
</div>
