{% comment %}
  Collection template
{% endcomment %}

<div class="collection-page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 36px; margin-bottom: 15px;">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p style="font-size: 18px; color: #666;">{{ collection.description }}</p>
    {% endif %}
  </div>

  {% if collection.products.size > 0 %}
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 30px; margin-bottom: 40px;">
      {% for product in collection.products %}
        <div style="border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; transition: transform 0.3s;">
          <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | image_url: width: 400 }}" 
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                style="width: 100%; height: 250px; object-fit: cover;"
              >
            {% else %}
              <div style="width: 100%; height: 250px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                No Image
              </div>
            {% endif %}
            
            <div style="padding: 20px;">
              <h3 style="font-size: 18px; margin-bottom: 10px;">{{ product.title }}</h3>
              <p style="font-weight: bold; color: #667eea;">{{ product.price | money }}</p>
              {% if product.compare_at_price > product.price %}
                <p style="font-size: 14px; color: #999; text-decoration: line-through;">
                  {{ product.compare_at_price | money }}
                </p>
              {% endif %}
            </div>
          </a>
        </div>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div style="text-align: center; margin-top: 40px;">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" style="padding: 10px 20px; margin: 0 5px; text-decoration: none; color: #667eea; border: 1px solid #667eea; border-radius: 4px;">Previous</a>
        {% endif %}

        <span style="margin: 0 10px;">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" style="padding: 10px 20px; margin: 0 5px; text-decoration: none; color: #667eea; border: 1px solid #667eea; border-radius: 4px;">Next</a>
        {% endif %}
      </div>
    {% endif %}
  {% else %}
    <div style="text-align: center; padding: 60px 20px;">
      <p style="font-size: 20px; color: #666;">No products found in this collection.</p>
    </div>
  {% endif %}
</div>

{% paginate collection.products by 16 %}
  {{ 'collection content' }}
{% endpaginate %}
